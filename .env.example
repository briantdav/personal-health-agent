# Garmin Connect account credentials.
# Garmin has no self-serve API for individual developers, so src/tools/garmin.py
# logs in as your own Garmin Connect account (same as the mobile app). Leave
# these unset to be prompted for email/password/MFA interactively instead.
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Where OAuth tokens are cached after first login, so you don't re-auth (or
# re-enter an MFA code) on every run. Defaults to ~/.garminconnect if unset.
GARMINTOKENS=~/.garminconnect
