<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Keeps the dashboard server running persistently — RunAtLoad starts it as
  soon as you log in, KeepAlive restarts it if it ever crashes/exits. This
  is what gives your phone something to actually reach: without this, the
  server only exists while a terminal you started it in stays open.

  Bound to 127.0.0.1 only — not reachable from your LAN or the internet on
  its own. `tailscale serve` (run separately, see CLAUDE.md) is what
  exposes it to your other devices, over your private tailnet only, with
  automatic HTTPS.

  NOTE for local development: this occupies port 8000 permanently. To
  iterate with `uvicorn --reload`, stop this first:
      launchctl unload ~/Library/LaunchAgents/com.personalhealthagent.server.plist
  ...then reload it when you're done:
      launchctl load ~/Library/LaunchAgents/com.personalhealthagent.server.plist

  Install (already done for you if Claude Code set this up — see
  CLAUDE.md's Architecture section):
      cp scripts/com.personalhealthagent.server.plist \
         ~/Library/LaunchAgents/com.personalhealthagent.server.plist
      launchctl load ~/Library/LaunchAgents/com.personalhealthagent.server.plist

  Uninstall:
      launchctl unload ~/Library/LaunchAgents/com.personalhealthagent.server.plist
      rm ~/Library/LaunchAgents/com.personalhealthagent.server.plist

  Logs: data/server.log (gitignored, like the rest of data/).
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.personalhealthagent.server</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/test1/personal-health-agent/.venv/bin/uvicorn</string>
        <string>src.web.app:app</string>
        <string>--host</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>8000</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/test1/personal-health-agent</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/test1/personal-health-agent/data/server.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/test1/personal-health-agent/data/server.log</string>
</dict>
</plist>
